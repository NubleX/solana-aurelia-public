{
  "name": "solana-aurelia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aurelia ($AURA) - Classic SPL token on Solana",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/lib/smoke.ts",
    "validator:local": "bash scripts/local-validator.sh",
    "smoke:local": "CLUSTER=devnet RPC_URL=http://127.0.0.1:8899 tsx src/lib/smoke.ts",
    "token:create:local": "CLUSTER=devnet RPC_URL=http://127.0.0.1:8899 tsx src/token/createToken.ts",
    "token:create:local:live": "CLUSTER=devnet RPC_URL=http://127.0.0.1:8899 tsx src/token/createToken.ts --live",
    "token:create": "tsx src/token/createToken.ts",
    "token:create:live": "tsx src/token/createToken.ts --live",
    "pool:meteora": "CLUSTER=mainnet-beta tsx src/token/createMeteoraPool.ts",
    "pool:meteora:live": "CLUSTER=mainnet-beta tsx src/token/createMeteoraPool.ts --live",
    "airdrop": "tsx src/airdrop/airdrop.ts",
    "airdrop:devnet": "CLUSTER=devnet RPC_URL=https://api.devnet.solana.com tsx src/airdrop/airdrop.ts",
    "airdrop:live": "tsx src/airdrop/airdrop.ts --live",
    "publish:assets": "tsx src/utils/publishAssets.ts",
    "publish:assets:verify": "tsx src/utils/publishAssets.ts --verify",
    "vest:rebalance": "CLUSTER=mainnet-beta tsx src/vesting/rebalanceAllocations.ts",
    "vest:rebalance:live": "CLUSTER=mainnet-beta tsx src/vesting/rebalanceAllocations.ts --live",
    "vest:squads:create": "CLUSTER=mainnet-beta tsx src/vesting/createSquads.ts",
    "vest:squads:create:live": "CLUSTER=mainnet-beta tsx src/vesting/createSquads.ts --live",
    "vest:squads:split": "CLUSTER=mainnet-beta tsx src/vesting/splitSquadsVault.ts",
    "vest:squads:split:live": "CLUSTER=mainnet-beta tsx src/vesting/splitSquadsVault.ts --live",
    "vest:gather:sender": "CLUSTER=mainnet-beta tsx src/vesting/gatherToStreamSender.ts",
    "vest:gather:sender:live": "CLUSTER=mainnet-beta tsx src/vesting/gatherToStreamSender.ts --live",
    "vest:streamflow": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowVests.ts",
    "vest:streamflow:live": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowVests.ts --live",
    "vest:streamflow:squads": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowToSquads.ts",
    "vest:streamflow:squads:live": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowToSquads.ts --live",
    "vest:streamflow:splitter": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowToSplitter.ts",
    "vest:streamflow:splitter:live": "CLUSTER=mainnet-beta tsx src/vesting/createStreamflowToSplitter.ts --live",
    "vest:splitter:init": "CLUSTER=mainnet-beta tsx src/vesting/initSplitter.ts",
    "vest:splitter:init:live": "CLUSTER=mainnet-beta tsx src/vesting/initSplitter.ts --live",
    "vest:splitter:split": "CLUSTER=mainnet-beta tsx src/vesting/splitCrank.ts",
    "vest:splitter:split:live": "CLUSTER=mainnet-beta tsx src/vesting/splitCrank.ts --live",
    "vest:splitter:build": "cargo-build-sbf --manifest-path programs/aura-splitter/Cargo.toml"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@metaplex-foundation/umi-web3js-adapters": "^0.9.2",
    "@meteora-ag/cp-amm-sdk": "^1.4.7",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "@sqds/multisig": "^2.1.4",
    "@streamflow/stream": "^13.4.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
